@model MVC2026.Clientes
@{
    ViewData["Title"] = "Cadastro de Clientes";
}

<div class="container">

    <h1 class="text-center mt-3 fw-bold">Cadastro de Cliente</h1>

    <form action="#" method="get">
        <div class="row">
            <div class="col-12 col-sm-3">
                <label asp-for="Id">Código</label>
                <input type="number" class="form-control" placeholder="Código do Cliente..." asp-for="Id">
            </div>
            <div class="col">
                <label asp-for="Nome">Nome Completo</label>
                <input type="text" class="form-control" placeholder="Nome Completo..." asp-for="Nome">
            </div>

        </div>
        <div class="col">
            <label asp-for="Endereco"></label>
            <input type="textarea" class="form-control" placeholder="seu endereço..." asp-for="Endereco">
        </div>
        <div class="row">
            <div class="col-12 col-sm-5">
                <label asp-for="Bairro"></label>
                <input type="textarea" class="form-control" placeholder="seu Bairro..." asp-for="Bairro">
            </div>
            <div class="col-12 col-sm-5">
                <label asp-for="Cidade"></label>
                <input type="textarea" class="form-control" placeholder="seu endereço..." asp-for="Cidade">
            </div>
            <div class="col-12 col-sm-2">
                <label asp-for="UF"></label>
                <input type="textarea" class="form-control" placeholder="UF..." asp-for="UF">
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-6">
                <label asp-for="CEP"></label>
                <input type="number" class="form-control" placeholder="seu CEP..." asp-for="CEP">
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="CPF"></label>
                <input type="text" class="form-control" placeholder="seu CPF..." asp-for="CPF">
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-5">
                <label asp-for="DataNascimento"></label>
                <input type="date" class="form-control" placeholder="seu CEP..." asp-for="DataNascimento">
            </div>
            <div class="col-12 col-sm-7">
                <label asp-for="Celular"></label>
                <input type="text" class="form-control" placeholder="(00) 00 000-000" asp-for="Celular">
            </div>
        </div>
                    <div class="col-12 col-sm">
                <label asp-for="Email"></label>
                <input type="text" class="form-control" placeholder="email.com" asp-for="Email">
            </div>
                    <div class="col">
                <label asp-for="Observacao"></label>
                <input type="text" class="form-control" placeholder="Observe..." asp-for="Observacao">
            </div>

        <div class="row mt-5">
            <div class="col text-center">
                <input type="reset" value="Limpar" class="w-50 btn btn-outline-secondary" />
            </div>
            <div class="col text-center">
                <input type="submit" value="Enviar" class="w-50 btn btn-primary" />
            </div>
        </div>

    </form>

    
</div>